# Dùng khi chạy Python trực tiếp trên máy (host) với hạ tầng của docker compose:
#   set -a; source .env.example; set +a
# Trong docker compose các biến này đã được đặt sẵn (địa chỉ nội bộ kafka:29092...).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
DATABASE_URL=postgresql://rides:rides@localhost:5432/rides

# Tuỳ chọn (giá trị mặc định ghi trong README)
# KAFKA_TOPIC=rides
# KAFKA_DLQ_TOPIC=rides.dlq
# KAFKA_CONSUMER_GROUP=ride-writer
# CONSUMER_BATCH_SIZE=500
# DB_RETRY_DEADLINE_S=120
# PRODUCE_RATE=200
# LOG_LEVEL=INFO

# Production: SASL/SSL cho Kafka và xác thực cho Schema Registry
# KAFKA_EXTRA_CONFIG=security.protocol=SASL_SSL,sasl.mechanism=PLAIN,sasl.username=...,sasl.password=...
# SCHEMA_REGISTRY_AUTH=user:password
# TOPIC_REPLICATION_FACTOR=3
# TOPIC_MIN_ISR=2
